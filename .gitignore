# --- Gradle ---
.gradle/
build/
out/
!gradle/wrapper/gradle-wrapper.jar

# --- NeoForge / ModDevGradle ---
# Local dev game directory: world saves, logs, crash reports, generated configs.
run/
run-data/
runs/
logs/
crash-reports/
# Generated by the neoForge runs block; regenerated on every IDE sync.
repo/

# --- IDE ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
bin/
.eclipse/

# --- Tooling / OS ---
__pycache__/
*.pyc
.DS_Store
Thumbs.db
*.log

# --- Third-party mob assets ---
# Models, animations and textures ripped from other mods for the bundled MobModels
# feature. They belong to their authors and must not be redistributed through this
# repository - only the addon's own namespace is tracked. The files still live on
# disk and still end up in a locally built jar; they are simply not published here.
# See README.md for what a clean clone does and does not contain.
src/main/resources/assets/*
!src/main/resources/assets/cnpcgeckoaddon/

# --- Notes ---
# lib/*.jar is deliberately NOT ignored. CustomNPCs and Ars Nouveau are not on any
# Maven repository, and build.gradle resolves them from lib/ via a flatDir repository,
# so a clone without them cannot compile. See lib/README.md.

# --- Markdown ---
# Notes, briefs and scratch write-ups are working material, not part of the mod. Only
# the README of a directory explains something a clone needs, so only those are kept.
*.md
!README.md

# --- Working prompts ---
# Task briefs handed to the agents that implement a feature, plus the index that orders
# them. Scratch work for whoever drives the session, not part of the mod. Ignoring the
# directory itself rather than its contents: nothing inside an excluded directory can be
# brought back by a later rule, so no README of ours can slip in through one.
prompts/
